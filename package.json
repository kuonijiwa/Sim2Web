{
  "name": "sim2web-viewer",
  "version": "0.2.0-dev.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:viewer": "vite build --config viewer/vite.config.js",
    "dev:viewer": "vite --config viewer/vite.config.js",
    "test:viewer": "node --test viewer/tests/lib.test.js",
    "build:workbench": "vite build --config workbench/vite.config.js",
    "dev:workbench": "vite --config workbench/vite.config.js",
    "test:workbench": "node --test workbench/tests/model.test.js",
    "build": "npm run build:viewer && npm run build:workbench"
  },
  "dependencies": {
    "@kitware/vtk.js": "^32.14.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright-core": "^1.49.1",
    "vite": "^6.0.5"
  }
}
